{
  "name": "vsys",
  "version": "1.0.0",
  "description": "Android Device Management System",
  "main": "main.js",
  "scripts": {
    "start": "NODE_ENV=development electron . --no-sandbox",
    "test": "NODE_ENV=development electron .",
    "build": "NODE_ENV=production electron-builder --linux --x64 --arm64",
    "build:x64": "NODE_ENV=production electron-builder --linux --x64",
    "build:arm64": "NODE_ENV=production electron-builder --linux --arm64"
  },
  "keywords": ["android", "device", "management"],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "udev": "^1.0.1"
  },
  "devDependencies": {
    "electron": "^38.4.0",
    "electron-builder": "^25.1.8",
    "electron-reload": "^2.0.0-alpha.1"
  },
  "build": {
    "appId": "com.vsys.app",
    "productName": "VSys",
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "category": "Utility",
      "maintainer": "VSys Team"
    },
    "files": [
      "main.js",
      "preload.js",
      "index.html",
      "renderer/**/*",
      "assets/**/*",
      "node_modules/**/*"
    ],
    "directories": {
      "output": "dist"
    }
  }
}
